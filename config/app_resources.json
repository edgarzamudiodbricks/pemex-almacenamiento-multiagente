{
  "name": "pemex-almacenamiento-chat",
  "description": "Chat PEMEX Almacenamiento: Genie (datos) + modelo de pronóstico (what-if), historial en Lakebase",
  "resources": [
    {"name": "genie-space", "genie_space": {"name": "PEMEX Almacenamiento - Inventarios y Pronóstico de Capacidad", "space_id": "<GENIE_SPACE_ID>", "permission": "CAN_RUN"}},
    {"name": "serving-endpoint", "serving_endpoint": {"name": "modelo_pronostico_capacidad", "permission": "CAN_QUERY"}},
    {"name": "sql-warehouse", "sql_warehouse": {"id": "<WAREHOUSE_ID>", "permission": "CAN_USE"}},
    {"name": "database", "postgres": {
      "branch": "projects/pemex-almacenamiento-chat/branches/production",
      "database": "projects/pemex-almacenamiento-chat/branches/production/databases/databricks-postgres",
      "permission": "CAN_CONNECT_AND_CREATE"}}
  ]
}
